{
  "info": {
    "name": "Personal Book Manager - Backend API",
    "description": "REST API collection for the Personal Book Manager backend (Auth, Books, Dashboard). Import along with the accompanying environment file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "bookId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Saurabh Yadav\",\n  \"email\": \"saurabh@example.com\",\n  \"password\": \"Passw0rd!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Register a new user. Body validated by auth.validator.js (name 2-100 chars, valid email, password 6-128 chars)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json().data;",
                  "  if (data && data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"saurabh@example.com\",\n  \"password\": \"Passw0rd!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Authenticate and receive a JWT. On success, the token is auto-saved to the {{token}} collection variable for use by every other request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "  if (data && data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Protected route. Requires Authorization: Bearer <token>. Logout is stateless — this just confirms the token is valid; the client is responsible for discarding it."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get Books (all)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "description": "Protected route. Returns all books belonging to the authenticated user."
          },
          "response": []
        },
        {
          "name": "Get Books (filter by status + tag)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?status=reading&tag=fiction",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "status", "value": "reading", "description": "want_to_read | reading | completed" },
                { "key": "tag", "value": "fiction" }
              ]
            },
            "description": "Protected route. Query params are validated by book.validator.js bookQuerySchema."
          },
          "response": []
        },
        {
          "name": "Add Book",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"tags\": [\"programming\", \"non-fiction\"],\n  \"status\": \"want_to_read\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Protected route. Creates a book owned by the authenticated user. title/author required; tags optional array; status optional (defaults to want_to_read)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json().data;",
                  "  if (data && data._id) {",
                  "    pm.collectionVariables.set('bookId', data._id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"reading\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Protected route. Updates a book owned by the authenticated user; at least one field required. Uses the {{bookId}} saved by the Add Book request (or set it manually)."
          },
          "response": []
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
            },
            "description": "Protected route. Deletes a book owned by the authenticated user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard"]
            },
            "description": "Protected route. Returns totalBooks, reading, completed, wantToRead counts, and recentBooks for the authenticated user."
          },
          "response": []
        }
      ]
    }
  ]
}
